@startuml
left to right direction
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowFontColor #111111
skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 18
}
skinparam actorStyle awesome

actor "Administrador" as Admin #08427b
actor "Residente" as Res #08427b
rectangle "API Gateway" as GW #0d9488
rectangle "Residential\nManagement" as RM #1e40af
rectangle "IAM / Auth" as IAM #1e40af
rectangle "Vínculo\nResidente-Unidad" as Link #f59e0b
rectangle "Usuario\n(Rol RESIDENT)" as User #f59e0b
rectangle "Token JWT" as Token #f59e0b

Admin -> Link : "1. registra"
Link -> RM : "2. persiste"
RM -> IAM : "3. provee vínculo"
IAM -> User : "4. crea y asigna rol"
Res -> GW : "5. envía credenciales"
GW -> IAM : "6. enruta"
IAM -> Token : "7. valida y emite"
Token -> Res : "8. habilita sesión"

legend right
  |= Color |= Elemento |
  |<#08427b>| Actor |
  |<#1e40af>| Bounded Context |
  |<#0d9488>| Infraestructura (Gateway) |
  |<#f59e0b>| Work Object |
endlegend

title Domain Story — Autenticación de residente
@enduml
