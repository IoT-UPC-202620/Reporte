@startuml
left to right direction
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowFontColor #111111
skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 18
}
skinparam actorStyle awesome

actor "Administrador" as Admin #08427b
actor "Residente" as Res #08427b
rectangle "Communication" as Comm #1e40af
rectangle "Notification" as Notif #1e40af
rectangle "Comunicado" as Anuncio #f59e0b
rectangle "Notificación Push" as Push #f59e0b

Admin -> Anuncio : "1. publica"
Anuncio -> Comm : "2. persiste"
Comm -> Notif : "3. emite evento\nComunicadoPublicado"
Notif -> Push : "4. crea"
Push -> Res : "5. entrega"
Push -> Push : "6. si falla el envío,\nqueda pendiente de reintento\n(compensación)"

legend right
  |= Color |= Elemento |
  |<#08427b>| Actor |
  |<#1e40af>| Bounded Context |
  |<#f59e0b>| Work Object |
endlegend

title Domain Story — Publicación de comunicados
@enduml
